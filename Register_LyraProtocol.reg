Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\lyragame]
@="URL:LyraGame Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\lyragame\DefaultIcon]
@="\"C:\\Path\\To\\LyraGame.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\lyragame\shell]

[HKEY_CURRENT_USER\Software\Classes\lyragame\shell\open]

[HKEY_CURRENT_USER\Software\Classes\lyragame\shell\open\command]
@="\"C:\\Path\\To\\Launch_LyraGame.bat\" \"%1\""
